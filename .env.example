# === SHVEYA / Perm_Repair .env.example ===
# Скопируй в .env и заполни реальными значениями

# --- Postgres / DATABASE ---
POSTGRES_USER=shveya
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASS_123
POSTGRES_DB=shveya
DATABASE_URL=postgresql://shveya:CHANGE_ME_STRONG_PASS_123@postgres:5432/shveya
# для локального запуска без docker:
# DATABASE_URL=postgresql://shveya:CHANGE_ME_STRONG_PASS_123@localhost:5432/shveya

# --- API ---
SECRET_KEY=CHANGE_ME_SUPER_SECRET_32CHARS_MIN
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
API_BASE_URL=http://api:8000
API_EXTERNAL_URL=https://api.your-domain.ru
ENV=production
LOG_LEVEL=info

# --- YooKassa (платежи) ---
YOOKASSA_SHOP_ID=1234567
YOOKASSA_SECRET_KEY=live_xxxxxxxxxxxxxxxxxxxxxxxx
YOOKASSA_RETURN_URL=https://your-domain.ru/payment/success

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=1234567890:AAH_xxx_your_bot_token_here
TELEGRAM_ADMIN_IDS=123456789,987654321
TELEGRAM_WEBHOOK_URL=https://your-domain.ru/bot/webhook

# --- S3 / Yandex Object Storage (опционально для фото) ---
S3_ENDPOINT=https://storage.yandexcloud.net
S3_BUCKET=shveya-uploads
S3_ACCESS_KEY=YCAJExxx
S3_SECRET_KEY=YCExxx
S3_REGION=ru-central1

# --- b2.medium tuning ---
UVICORN_WORKERS=2
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000

# --- Monitoring ---
SENTRY_DSN=
